{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-paths.sh\"" }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-sequencing.sh\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|reviewer|tester|blind-reviewer",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/warn-dor-dod.sh\"" }
        ]
      },
      {
        "matcher": "implementer|reviewer|tester|blind-reviewer|architect|planner",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/extract-knowledge.sh\"" }
        ]
      }
    ]
  }
}
